<% content_for :title, "Import Excel — WE Match" %>

<div class="page-header">
  <h1>Import Excel</h1>
</div>

<div class="card">
  <h2>What the file needs</h2>
  <p class="muted">
    Upload an Excel workbook (<code>.xlsx</code>). The first sheet needs a header row with
    <code>name</code> and <code>email</code>. Optionally
    <code>time_zone</code> (an IANA name such as <code>Europe/London</code>),
    <code>groups</code> (separated by <code>;</code>), and <code>cohort</code>.
  </p>
  <pre class="code-sample">name | email | time_zone | groups | cohort
Amara Okafor | amara@example.org | Africa/Lagos | WE Fellows;Explorers Circle | 2026
Priya Nair | priya@example.org | Asia/Kolkata | WE Fellows | 2026</pre>
  <p class="muted">
    People are matched on email: an existing email is updated, a new one is added. Nothing
    is written until you review the preview on the next screen.
  </p>
</div>

<div class="card form-card">
  <%= form_with url: import_path, method: :post, multipart: true, data: { turbo: false } do |form| %>
    <div class="form-group">
      <%= form.label :file, "Excel file (.xlsx)" %>
      <%= form.file_field :file, accept: ".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", required: true %>
      <p class="field-hint">Choose a <strong>.xlsx</strong> file, then click <strong>Preview import</strong> below.</p>
    </div>

    <div class="form-group form-group--checkbox">
      <%= form.check_box :create_missing_groups, {}, "1", "0" %>
      <%= form.label :create_missing_groups, "Create groups that don't exist yet" %>
    </div>

    <div class="actions">
      <%= form.submit "Preview import", class: "btn btn-primary" %>
      <%= link_to "Cancel", members_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>
