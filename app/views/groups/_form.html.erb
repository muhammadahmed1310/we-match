<%= form_with model: @group, local: true do |form| %>
  <% if @group.errors.any? %>
    <div class="form-errors">
      <ul>
        <% @group.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :name, "Group name" %>
    <%= form.text_field :name, placeholder: "e.g. WE Fellows" %>
  </div>

  <div class="form-group">
    <%= form.label :description, "Description (optional)" %>
    <%= form.text_area :description, rows: 3 %>
  </div>

  <div class="form-group">
    <%= form.label :cycle_programme_starts_on, "Matching start date" %>
    <%= form.date_field :cycle_programme_starts_on, required: true %>
    <p class="field-hint">Cycles will not open before this date.</p>
  </div>

  <div class="form-group">
    <%= form.label :cycle_programme_ends_on, "Matching end date (optional)" %>
    <%= form.date_field :cycle_programme_ends_on %>
    <p class="field-hint">Leave blank if matching has no end date.</p>
  </div>

  <p class="field-hint">
    Cycles run every two weeks between these dates.
    Invites go out Monday → people respond by Thursday → matches on Friday.
    If the start date is not a Monday, the first cycle opens on the next Monday on or after that date.
  </p>

  <div class="actions">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", @group.persisted? ? group_path(@group) : groups_path, class: "btn btn-secondary" %>
  </div>
<% end %>
