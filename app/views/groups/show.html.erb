<% content_for :title, "#{@group.name} — WE Match" %>

<div class="page-header">
  <h1><%= @group.name %></h1>
  <div class="actions">
    <%= link_to "Edit", edit_group_path(@group), class: "btn btn-secondary" %>
    <%= link_to "All groups", groups_path, class: "btn btn-secondary" %>
  </div>
</div>

<p class="muted"><%= @group.description %></p>

<div class="card">
  <h2>Matching window</h2>
  <p class="muted">
    Cycles run every two weeks between these dates.
    Invites Monday → respond by Thursday → matches Friday.
  </p>
  <p><%= @group.programme_window_label %></p>
  <% if @group.auto_cycle_last_opened_on.present? %>
    <p class="muted">Last automatic cycle opened <%= @group.auto_cycle_last_opened_on.strftime("%b %-d, %Y") %></p>
  <% end %>
</div>

<div class="card">
  <h2>Users (<%= @members.size %>)</h2>
  <% if @members.any? %>
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Time zone</th>
        </tr>
      </thead>
      <tbody>
        <% @members.each do |member| %>
          <tr>
            <td><%= link_to member.name, member_path(member) %></td>
            <td><%= member.email %></td>
            <td><%= member.time_zone %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="muted">
      Nobody in this group yet. <%= link_to "Add someone", new_member_path %> or
      <%= link_to "import from Users", new_import_path %>.
    </p>
  <% end %>
</div>

<div class="card">
  <h2>Topics offered here</h2>
  <% if @topics.any? %>
    <ul class="plain-list">
      <% @topics.each do |topic| %>
        <li><%= link_to topic.name, topic_path(topic) %> <span class="muted">(<%= topic.scope_label %>)</span></li>
      <% end %>
    </ul>
  <% else %>
    <p class="muted">No active topics. <%= link_to "Add one", new_topic_path %> before opening a cycle.</p>
  <% end %>
</div>

<div class="card">
  <h2>Match cycles</h2>
  <% if @match_cycles.any? %>
    <table>
      <thead>
        <tr>
          <th>Status</th>
          <th>Opens</th>
          <th>Closes</th>
          <th>Responses</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @match_cycles.each do |cycle| %>
          <tr>
            <td><span class="badge badge-<%= cycle.status %>"><%= cycle.status %></span></td>
            <td><%= cycle.opens_at&.strftime("%b %-d, %Y") || "—" %></td>
            <td><%= cycle.closes_at&.strftime("%b %-d, %Y") || "—" %></td>
            <td><%= cycle.responded_count %> / <%= cycle.invited_count %></td>
            <td><%= link_to "View", match_cycle_path(cycle) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="muted">No match cycles for this group yet.</p>
  <% end %>
</div>

<div class="card">
  <h2>Danger zone</h2>
  <p class="muted">Deleting a group also deletes its cycles, responses, and matches. People stay under Users.</p>
  <%= button_to "Delete group", group_path(@group), method: :delete, class: "btn btn-secondary",
        data: { turbo_confirm: "Delete #{@group.name} and all of its cycles?" } %>
</div>
