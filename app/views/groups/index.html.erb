<% content_for :title, "Groups — WE Match" %>

<div class="page-header">
  <h1>Groups</h1>
  <div class="actions">
    <%= link_to "New group", new_group_path, class: "btn btn-primary" %>
  </div>
</div>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Description</th>
      <th>People</th>
      <th>Matching</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @groups.each do |group| %>
      <tr>
        <td><%= link_to group.name, group_path(group) %></td>
        <td><%= truncate(group.description.to_s, length: 80) %></td>
        <td><%= group.members.size %></td>
        <td><%= group.programme_window_label %></td>
        <td>
          <%= link_to "View", group_path(group) %>
          <%= link_to "Edit", edit_group_path(group) %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<% if @groups.none? %>
  <p class="muted">No groups yet. Create one, then import the people who belong to it.</p>
<% end %>
