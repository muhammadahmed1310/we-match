<% content_for :title, "#{@member.name} — WE Match" %>

<div class="page-header">
  <h1><%= @member.name %></h1>
  <div class="actions">
    <%= link_to "Edit", edit_member_path(@member), class: "btn btn-secondary" %>
    <%= link_to "Users", members_path, class: "btn btn-secondary" %>
  </div>
</div>

<p class="muted"><%= @member.email %> · <%= @member.time_zone %></p>

<div class="card">
  <h2>Groups</h2>
  <% if @memberships.any? %>
    <ul class="plain-list">
      <% @memberships.each do |membership| %>
        <li>
          <%= link_to membership.group.name, group_path(membership.group) %>
          <% if membership.cohort.present? %>
            <span class="muted">· <%= membership.cohort %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="muted">Not in any group yet, so they won't be invited to a cycle.</p>
  <% end %>
</div>

<div class="card">
  <h2>Match responses</h2>
  <% if @match_responses.any? %>
    <table>
      <thead>
        <tr>
          <th>Cycle</th>
          <th>Topic</th>
          <th>Windows (their time)</th>
          <th>Matched</th>
        </tr>
      </thead>
      <tbody>
        <% @match_responses.each do |response| %>
          <tr>
            <td><%= link_to response.match_cycle.group.name, match_cycle_path(response.match_cycle) %></td>
            <td><%= response.topic&.name || "—" %></td>
            <td>
              <% labels = response.slot_labels(@member.time_zone) %>
              <%= labels.any? ? labels.join(" · ") : "—" %>
            </td>
            <td><%= response.matched? ? "Yes" : "No" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="muted">No responses yet.</p>
  <% end %>
</div>

<div class="card">
  <h2>Danger zone</h2>
  <p class="muted">Removing someone deletes their responses and matches too.</p>
  <%= button_to "Remove user", member_path(@member), method: :delete, class: "btn btn-secondary",
        data: { turbo_confirm: "Remove #{@member.name}?" } %>
</div>
