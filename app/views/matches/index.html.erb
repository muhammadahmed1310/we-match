<% content_for :title, "Matches — WE Match" %>

<div class="page-header">
  <h1>Matches</h1>
  <div class="actions">
    <%= link_to "Back to cycle", match_cycle_path(@match_cycle), class: "btn btn-secondary" %>
    <%= link_to "Report", cycle_report_path(@match_cycle), class: "btn btn-secondary" %>
  </div>
</div>

<p class="muted">
  <%= @match_cycle.group.name %> —
  <span class="badge badge-<%= @match_cycle.status %>"><%= @match_cycle.status %></span>
</p>

<div class="card">
  <% if @matches.any? %>
    <% @matches.each do |match| %>
      <div class="match-pair">
        <h3><%= match.pair_label %></h3>
        <p>
          <strong>Topic:</strong> <%= match.topic&.name || "not recorded" %>
        </p>
        <% if match.slot_label_utc.present? %>
          <p>
            <strong>Shared window:</strong> <%= match.slot_label_utc %>
          </p>
          <ul class="plain-list">
            <% [ match.member_one, match.member_two ].each do |member| %>
              <li class="muted"><%= member.name %>: <%= match.slot_label_for(member) %></li>
            <% end %>
          </ul>
        <% end %>
        <p class="muted">
          <% if MailDelivery.enabled? %>
            Introduction email queued to both people.
          <% else %>
            Email delivery is off — introduce these two yourself.
          <% end %>
        </p>
      </div>
    <% end %>
  <% else %>
    <p class="muted">No matches for this cycle yet. Collect responses and run matching.</p>
  <% end %>
</div>
