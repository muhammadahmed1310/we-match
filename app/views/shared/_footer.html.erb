<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <%= we_logo_image(variant: :reverse) %>
      <span class="site-footer__logo">WE Match</span>
      <p class="site-footer__tagline">
        Structured one-on-one connections for women in the WE Community.
      </p>
    </div>

    <div class="site-footer__links">
      <div class="site-footer__column">
        <h3>Explore</h3>
        <ul>
          <li><%= link_to "Dashboard", root_path %></li>
          <li><%= link_to "Groups", groups_path %></li>
          <li><%= link_to "Users", members_path %></li>
          <li><%= link_to "Match Cycles", match_cycles_path %></li>
        </ul>
      </div>
      <div class="site-footer__column">
        <h3>Quick actions</h3>
        <ul>
          <li><%= link_to "New match cycle", new_match_cycle_path %></li>
          <% if Rails.env.development? %>
            <li><%= link_to "Mailer previews", "/rails/mailers" %></li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>

  <div class="site-footer__bottom">
    <p>&copy;<%= Time.current.year %>: Women Emerging</p>
  </div>
</footer>
