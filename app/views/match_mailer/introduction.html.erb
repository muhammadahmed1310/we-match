<p>Hello <%= @member_one.name %> and <%= @member_two.name %>,</p>

<p>You've been matched in <strong><%= @group.name %></strong> for a one-on-one conversation.</p>

<% if @topic.present? %>
  <p>You both chose the same topic: <strong><%= @topic.name %></strong>.</p>
<% end %>

<% if @slot_utc.present? %>
  <p>You both marked this 1-hour window as workable:</p>
  <p><strong><%= @slot_utc %></strong></p>
  <ul>
    <% @local_slots.each do |member, label| %>
      <% next if label.blank? %>
      <li><%= member.name %>: <%= label %></li>
    <% end %>
  </ul>
<% end %>

<p>This is the window you both picked. Reach out to each other to start the conversation.</p>

<p>— WE Match</p>
