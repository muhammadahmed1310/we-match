<% content_for :title, "Share your availability — WE Match" %>

<div class="card participant-card">
  <h1>Hello <%= @member.name.split.first %></h1>
  <p class="muted">
    <%= @group.name %> · responses close
    <%= @match_cycle.closes_at ? utc_time(@match_cycle.closes_at, format: "%A %b %-d, %H:%M UTC") : "when the round is closed" %>
  </p>

  <% if @match_response.persisted? %>
    <div class="notice notice--info">
      You've already responded. You can change your answers below until the round closes.
    </div>
  <% end %>

  <%= form_with model: @match_response,
                url: participant_response_path(token: @invitation.token),
                method: :patch,
                local: true,
                data: { controller: "topic-options" } do |form| %>
    <% if @match_response.errors.any? %>
      <div class="form-errors">
        <ul>
          <% @match_response.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-group" data-controller="time-zone" data-time-zone-auto-value="<%= params[:tz].blank? && @match_response.time_zone == 'UTC' %>">
      <%= form.label :time_zone, "Your time zone" %>
      <%= form.select :time_zone,
                      options_for_select(time_zone_options, @match_response.time_zone),
                      {},
                      data: { time_zone_target: "select", action: "change->time-zone#reload" } %>
      <p class="field-hint">All times below are shown in this zone. Change it and the windows update.</p>
    </div>

    <div class="form-group">
      <%= form.label :topic_id, "What would you like to talk about?" %>
      <%= form.collection_select :topic_id, @topics, :id, :name,
                                 { prompt: "Choose a topic" },
                                 data: { topic_options_target: "topic", action: "change->topic-options#topicChanged" } %>
    </div>

    <%# Falls back to "no option" when the chosen topic has no dropdown of its own. %>
    <%= hidden_field_tag "match_response[topic_option_id]", "", id: nil %>

    <% @topics.each do |topic| %>
      <% next if topic.selectable_options.empty? %>
      <div class="form-group topic-option-group"
           data-topic-options-target="optionGroup"
           data-topic-id="<%= topic.id %>"
           <%= "hidden" unless @match_response.topic_id == topic.id %>>
        <%= label_tag "topic_option_#{topic.id}", "Which part of #{topic.name}?" %>
        <%= form.select :topic_option_id,
                        options_from_collection_for_select(topic.selectable_options, :id, :label, @match_response.topic_option_id),
                        { include_blank: "No preference" },
                        id: "topic_option_#{topic.id}",
                        disabled: @match_response.topic_id != topic.id,
                        data: { topic_options_target: "optionSelect" } %>
        <p class="field-hint">
          This helps us understand what the WE Community wants to explore. It is never shown to the person you're matched with.
        </p>
      </div>
    <% end %>

    <div class="form-group">
      <%= form.label :topic_option_other, "Anything else you'd like us to know? (optional)" %>
      <%= form.text_field :topic_option_other, maxlength: 200, placeholder: "In your own words" %>
    </div>

    <fieldset class="form-group slot-picker">
      <legend>Pick one or two 1-hour windows</legend>
      <p class="field-hint">
        Week of <%= @match_cycle.meeting_week_range.first.strftime("%b %-d") %>. You and your match agree the exact date between yourselves — these windows just tell us who overlaps.
      </p>

      <% selections = @match_response.slot_selections %>
      <div class="slot-picker__row">
        <label for="slot_selection_1">First window</label>
        <%= select_tag "match_response[slot_selections][]",
                       grouped_options_for_select(@windows.grouped_options, selections[0]),
                       include_blank: "Choose a window",
                       id: "slot_selection_1" %>
      </div>

      <div class="slot-picker__row">
        <label for="slot_selection_2">Second window (optional)</label>
        <%= select_tag "match_response[slot_selections][]",
                       grouped_options_for_select(@windows.grouped_options, selections[1]),
                       include_blank: "No second window",
                       id: "slot_selection_2" %>
      </div>
    </fieldset>

    <div class="actions">
      <%= form.submit @match_response.persisted? ? "Update my response" : "Submit my response", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
