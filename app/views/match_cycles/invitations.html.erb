<% content_for :title, "Invitation links — WE Match" %>

<div class="page-header">
  <h1>Invitation links</h1>
  <div class="actions">
    <%= link_to "Download CSV", invitations_match_cycle_path(@match_cycle, format: :csv), class: "btn btn-primary" %>
    <%= link_to "Back to the cycle", match_cycle_path(@match_cycle), class: "btn btn-secondary" %>
  </div>
</div>

<p class="muted"><%= @match_cycle.group.name %></p>

<% unless MailDelivery.enabled? %>
  <div class="notice notice--warning">
    <strong>Email delivery is switched off.</strong>
    Invitations are recorded but not sent, so send these links yourself — by email, WhatsApp,
    or however this group already hears from you.
  </div>
<% end %>

<div class="card">
  <p class="muted">
    Each link identifies one person. Send each row only to the person it belongs to.
  </p>

  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Link</th>
        <th>Responded</th>
      </tr>
    </thead>
    <tbody>
      <% @invitations.each do |invitation| %>
        <tr>
          <td><%= invitation.member.name %></td>
          <td><%= invitation.member.email %></td>
          <td class="link-cell"><%= invitation.response_url %></td>
          <td><%= invitation.responded_at ? "Yes" : "No" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= render "shared/pagination", page: @invitations_page %>
</div>
