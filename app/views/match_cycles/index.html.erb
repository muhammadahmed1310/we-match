<% content_for :title, "Match cycles — WE Match" %>

<div class="page-header">
  <h1>Match Cycles</h1>
  <%= link_to "New cycle", new_match_cycle_path, class: "btn btn-primary" %>
</div>

<table>
  <thead>
    <tr>
      <th>Group</th>
      <th>Status</th>
      <th>Opens</th>
      <th>Closes</th>
      <th>Responses</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @match_cycles.each do |cycle| %>
      <tr>
        <td><%= cycle.group.name %></td>
        <td>
          <span class="badge badge-<%= cycle.status %>"><%= cycle.status %></span>
          <% if cycle.auto_created? %>
            <span class="muted">auto</span>
          <% end %>
        </td>
        <td><%= cycle.opens_at&.strftime("%b %-d, %Y") || "—" %></td>
        <td><%= cycle.closes_at&.strftime("%b %-d, %Y") || "—" %></td>
        <td><%= cycle.responded_count %> / <%= cycle.invited_count %></td>
        <td class="actions">
          <%= link_to "View", match_cycle_path(cycle), class: "btn btn-link" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<% if @match_cycles.none? %>
  <p class="muted">No cycles yet. <%= link_to "Create one", new_match_cycle_path %>.</p>
<% end %>
