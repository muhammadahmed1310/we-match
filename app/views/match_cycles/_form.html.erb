<%# locals: (match_cycle:, mode: :new) %>
<%= form_with model: match_cycle, local: true do |form| %>
  <% if match_cycle.errors.any? %>
    <div class="form-errors">
      <ul>
        <% match_cycle.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if mode == :new %>
    <div class="form-group">
      <%= form.label :group_id, "Group" %>
      <%= form.collection_select :group_id, @groups, :id, :name, prompt: "Select a group" %>
    </div>

    <p class="field-hint">
      We’ll set the usual rhythm for you: responses open now, close in about three days,
      and the meeting week is the week after. Then send invitations from the cycle page.
    </p>
  <% else %>
    <div class="form-group">
      <label>Group</label>
      <p><strong><%= match_cycle.group.name %></strong></p>
    </div>

    <div class="form-group">
      <%= form.label :closes_at, "Responses close at" %>
      <%= form.datetime_local_field :closes_at %>
      <p class="field-hint">People can change their answers until this time.</p>
    </div>

    <div class="form-group">
      <%= form.label :meeting_week_start, "Meeting week starts (Monday)" %>
      <%= form.date_field :meeting_week_start %>
      <p class="field-hint">The 1-hour windows on the response form fall in this week.</p>
    </div>
  <% end %>

  <div class="actions">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", match_cycle.persisted? ? match_cycle_path(match_cycle) : match_cycles_path, class: "btn btn-secondary" %>
  </div>
<% end %>
