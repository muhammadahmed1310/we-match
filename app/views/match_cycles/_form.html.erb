<%= form_with model: match_cycle, local: true do |form| %>
  <% if match_cycle.errors.any? %>
    <div class="form-errors">
      <ul>
        <% match_cycle.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :group_id, "Group" %>
    <%= form.collection_select :group_id, @groups, :id, :name, prompt: "Select a group" %>
  </div>

  <div class="form-group">
    <%= form.label :status %>
    <%= form.select :status, MatchCycle.statuses.keys.map { |s| [ s.humanize, s ] } %>
    <p class="field-hint">Draft links don't work yet. Sending invitations opens the cycle.</p>
  </div>

  <div class="form-group">
    <%= form.label :opens_at, "Opens at (UTC)" %>
    <%= form.datetime_local_field :opens_at %>
  </div>

  <div class="form-group">
    <%= form.label :closes_at, "Closes at (UTC)" %>
    <%= form.datetime_local_field :closes_at %>
    <p class="field-hint">Responses are refused outside this window, and the cycle closes itself when it passes.</p>
  </div>

  <div class="form-group">
    <%= form.label :meeting_week_start, "Meeting week starts (Monday)" %>
    <%= form.date_field :meeting_week_start %>
    <p class="field-hint">The 1-hour windows offered on the response form fall in this week.</p>
  </div>

  <div class="actions">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", match_cycles_path, class: "btn btn-secondary" %>
  </div>
<% end %>
