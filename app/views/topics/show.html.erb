<% content_for :title, "#{@topic.name} — WE Match" %>

<div class="page-header">
  <h1><%= @topic.name %></h1>
  <div class="actions">
    <%= link_to "Back to topics", topics_path, class: "btn btn-secondary" %>
    <%= link_to "Add subtopic", new_topic_topic_option_path(@topic), class: "btn btn-primary" %>
  </div>
</div>

<p class="muted"><%= pluralize(@response_count, "response") %> so far</p>

<div class="card">
  <h2>Subtopics</h2>
  <p class="muted">
    Asked after the match in the feedback email: which angle resonated most.
    Counted in Reports, never shown in introduction emails.
  </p>

  <% if @topic_options.any? %>
    <table>
      <thead>
        <tr>
          <th>Subtopic</th>
          <th>Chosen</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @topic_options.each do |option| %>
          <tr>
            <td><%= option.label %></td>
            <td><%= @option_counts[option.id] || 0 %></td>
            <td class="actions">
              <%= link_to "Edit", edit_topic_topic_option_path(@topic, option), class: "btn btn-link" %>
              <%= button_to "Remove", topic_topic_option_path(@topic, option), method: :delete,
                    class: "btn btn-link", data: { turbo_confirm: "Remove this subtopic?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="muted">No subtopics yet. People can still choose the topic without picking a specific angle.</p>
  <% end %>
</div>
