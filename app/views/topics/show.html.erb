<% content_for :title, "#{@topic.name} — WE Match" %>

<div class="page-header">
  <h1><%= @topic.name %></h1>
  <div class="actions">
    <%= link_to "Back to topics", topics_path, class: "btn btn-secondary" %>
  </div>
</div>

<p class="muted"><%= pluralize(@response_count, "response") %> so far</p>

<div class="card">
  <h2>Subtopics</h2>
  <p class="muted">
    Asked after the match in the feedback email: which angle resonated most.
    Counted in Reports, never shown in introduction emails.
  </p>

  <% if @topic.collects_details_on_response? %>
    <p class="muted">
      This topic collects an open-text note when someone responds (their leadership dilemma).
      There are no fixed subtopics.
    </p>
  <% elsif @topic_options.any? %>
    <table>
      <thead>
        <tr>
          <th>Subtopic</th>
          <th>Chosen</th>
        </tr>
      </thead>
      <tbody>
        <% @topic_options.each do |option| %>
          <tr>
            <td><%= option.other? ? "Other (what)" : option.label %></td>
            <td><%= @option_counts[option.id] || 0 %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="muted">No subtopics on this topic.</p>
  <% end %>
</div>
