<% content_for :title, "Topics — WE Match" %>

<div class="page-header">
  <h1>Topics</h1>
  <div class="actions">
    <%= link_to "New topic", new_topic_path, class: "btn btn-primary" %>
  </div>
</div>

<p class="muted">
  Topics are what people choose when they respond. Add subtopics under each topic —
  asked after the match in the feedback email for private insight.
</p>

<div class="card">
  <% if @topics.any? %>
    <table>
      <thead>
        <tr>
          <th>Topic</th>
          <th>Subtopics</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @topics.each do |topic| %>
          <tr>
            <td><%= topic.name %></td>
            <td><%= topic.topic_options.size %></td>
            <td class="actions">
              <%= link_to "Subtopics", topic_path(topic), class: "btn btn-link" %>
              <%= link_to "Edit", edit_topic_path(topic), class: "btn btn-link" %>
              <%= button_to "Delete", topic_path(topic), method: :delete, class: "btn btn-link",
                    data: { turbo_confirm: "Delete #{topic.name}?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="muted">No topics yet. Add the handful of themes your groups actually talk about.</p>
  <% end %>
</div>
