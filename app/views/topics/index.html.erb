<% content_for :title, "Topics — WE Match" %>

<div class="page-header">
  <h1>Topics</h1>
</div>

<p class="muted">
  Topics are what people choose when they respond. Subtopics are asked after the match
  in the feedback email for private insight. Topics are managed by the WE Match team —
  view only here.
</p>

<div class="card">
  <% if @topics.any? %>
    <table>
      <thead>
        <tr>
          <th>Topic</th>
          <th>Subtopics</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @topics.each do |topic| %>
          <tr>
            <td><%= topic.name %></td>
            <td>
              <% if topic.collects_details_on_response? %>
                Open text on response
              <% else %>
                <%= topic.topic_options.size %>
              <% end %>
            </td>
            <td class="actions">
              <%= link_to "View", topic_path(topic), class: "btn btn-link" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="muted">No topics yet. Ask the WE Match team to load the programme topics.</p>
  <% end %>
</div>
