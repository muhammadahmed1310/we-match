<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "WE Match" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="site-body site-body--minimal">
    <div class="site-backdrop" aria-hidden="true"></div>

    <main class="minimal-shell">
      <div class="minimal-shell__brand">
        <%= we_logo_image %>
        <span class="minimal-shell__tagline">Meet. Share. Learn</span>
      </div>

      <%= render "shared/flash" %>

      <div class="minimal-shell__content">
        <%= yield %>
      </div>

      <p class="minimal-shell__footer">&copy;<%= Time.current.year %>: Women Emerging</p>
    </main>
  </body>
</html>
