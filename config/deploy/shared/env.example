# Copy to the server as /var/www/we-match/shared/.env
# Never commit real secrets.

RAILS_ENV=production
APP_HOST=match.womenemerging.org

RAILS_MASTER_KEY=
SECRET_KEY_BASE=

DATABASE_URL=postgres://we_match:CHANGE_ME@127.0.0.1:5432/we_match_production

EMAIL_DELIVERY_ENABLED=true
MAIL_FROM=WE Match <match@womenemerging.org>
SMTP_ADDRESS=smtp.resend.com
SMTP_PORT=587
SMTP_DOMAIN=womenemerging.org
SMTP_AUTHENTICATION=plain
SMTP_USERNAME=resend
SMTP_PASSWORD=

# Admin-only email previews at /rails/mailers (not linked in the UI).
SHOW_MAILER_PREVIEWS=true
SEED_DEMO=false
